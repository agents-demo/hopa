# HOPA phone runtime configuration.
# Copy this file to .env and fill in the values. .env is gitignored.

# hdc target / device UDID. Leave empty to auto-detect the only connected device.
HOPA_DEVICE=

# PC bridge. Over the USB reverse tunnel the phone reaches the PC at 127.0.0.1.
HOPA_BRIDGE_URL=http://127.0.0.1:8765
# Use the token printed by `pc-agent bridge`, or choose your own.
HOPA_BRIDGE_TOKEN=

# Model settings. Fill these three.
# Provider: openai | anthropic | gemini | deepseek
# OpenAI-compatible base URLs normally include /v1, e.g. https://api.deepseek.com/v1
HOPA_MODEL_PROVIDER=deepseek
HOPA_MODEL_BASE_URL=https://api.deepseek.com
HOPA_MODEL_NAME=deepseek-flash
HOPA_MODEL_API_KEY=
