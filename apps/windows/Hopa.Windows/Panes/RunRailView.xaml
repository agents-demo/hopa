<UserControl x:Class="Hopa.Windows.Panes.RunRailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>

    <Border Background="#FFFFFF" CornerRadius="14" BorderBrush="#E9E4DA" BorderThickness="1"
            Padding="14,12,14,10">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="9"
                       FontWeight="Bold" Foreground="#9A9488" />
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8,0,0">
                <Ellipse Width="7" Height="7" Fill="{Binding Dot}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" FontSize="15" FontWeight="Medium"
                           Foreground="#1C1B18" Margin="7,0,0,0" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Facts}" FontSize="10.5"
                       Foreground="#9A9488" Margin="0,3,0,0" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding Earlier}" FontSize="10"
                       Foreground="#9A9488" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding HasEarlier, Converter={StaticResource Visible}}" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding Measured}" FontSize="10"
                       Foreground="#9A9488" Margin="0,6,0,0"
                       Visibility="{Binding HasMeasured, Converter={StaticResource Visible}}" />

            <Border DockPanel.Dock="Bottom" BorderBrush="#E9E4DA" BorderThickness="0,1,0,0"
                    Padding="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{Binding BridgeDot}"
                             VerticalAlignment="Top" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding BridgeText}" FontSize="10" Foreground="#9A9488"
                               Margin="6,0,0,0" TextWrapping="Wrap" Width="196" />
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="18" Height="18" CornerRadius="9"
                                        Background="{Binding Dot}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Number}" FontSize="9.5"
                                               Foreground="#FFFFFF" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Verb}" FontSize="11.5"
                                               Foreground="#1C1B18" />
                                    <TextBlock Text="{Binding Detail}" FontSize="10"
                                               Foreground="#9A9488" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
