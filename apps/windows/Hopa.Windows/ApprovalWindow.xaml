<Window x:Class="Hopa.Windows.ApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Approval"
        Height="380" Width="520"
        Background="#F7F4EE"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleLabel" FontSize="20" FontWeight="SemiBold" Foreground="#1C1B18" />
            <TextBlock x:Name="BodyLabel" FontSize="13" Foreground="#6B665C" TextWrapping="Wrap"
                       Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock x:Name="AmountLabel" FontSize="14" Foreground="#1C1B18" Margin="0,0,0,6" />
            <TextBlock x:Name="MerchantLabel" FontSize="13" Foreground="#6B665C" Margin="0,0,0,6" />
            <TextBlock x:Name="ConsequenceLabel" FontSize="12" Foreground="#B26A00"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="DenyButton" Content="Deny" Width="96" Height="34" Margin="0,0,8,0"
                    Click="Deny_Click" />
            <Button x:Name="AllowButton" Content="Allow" Width="96" Height="34"
                    Background="#0A59F7" Foreground="#FFFFFF" BorderThickness="0"
                    Click="Allow_Click" />
        </StackPanel>
    </Grid>
</Window>
