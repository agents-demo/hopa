<Window x:Class="Hopa.Windows.Ui.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Icon="pack://application:,,,/Hopa.Windows;component/Assets/hopa.ico"
        Height="760" Width="900"
        Background="#F7F4EE"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F7F4EE" BorderBrush="#E9E4DA" BorderThickness="0,0,0,1"
                Padding="22,14" MouseLeftButtonDown="Header_Drag">
            <Grid>
                <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold" Foreground="#1C1B18"
                           VerticalAlignment="Center" />
                <TextBox x:Name="SettingsSearch" Width="230" Height="28" HorizontalAlignment="Right"
                         Margin="0,0,44,0" ToolTip="Search settings"
                         TextChanged="SettingsSearch_TextChanged" />
                <Button Content="&#x2715;" HorizontalAlignment="Right" Width="30" Height="28"
                        Background="Transparent" BorderThickness="0" Foreground="#6B665C"
                        Click="Close_Click" AutomationProperties.Name="Close settings" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22,16,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="SettingsNav" SelectionChanged="SettingsNav_SelectionChanged">
                <ListBoxItem Tag="general" Content="General" />
                <ListBoxItem Tag="act" Content="Act" />
                <ListBoxItem Tag="run" Content="Run" />
                <ListBoxItem Tag="profiles" Content="Profiles" />
                <ListBoxItem Tag="memory" Content="Memory" />
                <ListBoxItem Tag="skills" Content="Skills" />
                <ListBoxItem Tag="usage" Content="Usage" />
                <ListBoxItem Tag="capabilities" Content="Capabilities" />
                <ListBoxItem Tag="howacts" Content="How HOPA acts" />
                <ListBoxItem Tag="recipes" Content="Recipes" />
                <ListBoxItem Tag="history" Content="History" />
                <ListBoxItem Tag="privacy" Content="Privacy" />
                <ListBoxItem Tag="notifications" Content="Notifications" />
                <ListBoxItem Tag="launchpad" Content="Launchpad" />
                <ListBoxItem Tag="browser" Content="Browser" />
                <ListBoxItem Tag="selfcheck" Content="Self check" />
                <ListBoxItem Tag="about" Content="About" />
            </ListBox>

            <Border Grid.Column="1" Background="#E9E4DA" Margin="12,0" />

            <ScrollViewer Grid.Column="2" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel x:Name="GeneralPage">
                        <TextBlock Text="Phone link (backend gateway)" FontSize="11.5" Foreground="#6B665C" />
                        <TextBox x:Name="GatewayLinkBox" Height="32" Margin="0,4,0,0"
                                 ToolTip="Paste the hopa://pair?... link the backend printed for this PC." />
                        <TextBlock Text="Paste the hopa://pair link for this PC, then pair once."
                                   FontSize="9.5" Foreground="#9A9488" Margin="0,3,0,6" />
                        <Button x:Name="PairGatewayButton" Content="Pair this PC" Width="120" Height="32"
                                HorizontalAlignment="Left" Click="PairGateway_Click" />
                        <TextBlock x:Name="GatewayStatusText" FontSize="10" Foreground="#6B665C"
                                   Margin="0,4,0,12" TextWrapping="Wrap" />

                        <TextBlock Text="Bridge" FontSize="11.5" Foreground="#6B665C" />
                        <TextBox x:Name="BridgeUrlBox" Height="32" Margin="0,4,0,0" />
                        <TextBlock Text="Bridge address, e.g. http://127.0.0.1:8901" FontSize="9.5"
                                   Foreground="#9A9488" Margin="0,3,0,8" />
                        <TextBlock Text="Bridge token" FontSize="11.5" Foreground="#6B665C" />
                        <PasswordBox x:Name="BridgeTokenBox" Height="32" Margin="0,4,0,8" />

                        <TextBlock Text="Model" FontSize="11.5" Foreground="#6B665C" />
                        <ComboBox x:Name="ProviderBox" Height="32" Margin="0,4,0,8"
                                  SelectionChanged="Provider_Changed">
                            <ComboBoxItem Content="openai" />
                            <ComboBoxItem Content="lan" />
                            <ComboBoxItem Content="stub" />
                        </ComboBox>
                        <TextBlock x:Name="DemoHint" Text="Demo answers with a small canned set. No endpoint, model or key is used."
                                   FontSize="10" Foreground="#9A9488" TextWrapping="Wrap"
                                   Margin="0,0,0,12" Visibility="Collapsed" />
                        <StackPanel x:Name="CloudModelFields">
                            <TextBlock Text="Base URL" FontSize="11.5" Foreground="#6B665C" />
                            <TextBox x:Name="BaseUrlBox" Height="32" Margin="0,4,0,8" />
                            <TextBlock Text="Model name" FontSize="11.5" Foreground="#6B665C" />
                            <TextBox x:Name="ModelNameBox" Height="32" Margin="0,4,0,8" />
                            <TextBlock Text="Model key (stored in Windows Credential Manager)" FontSize="11.5"
                                       Foreground="#6B665C" />
                            <PasswordBox x:Name="ModelKeyBox" Height="32" Margin="0,4,0,12" />
                        </StackPanel>

                        <TextBlock Text="Tone" FontSize="11.5" Foreground="#6B665C" />
                        <ComboBox x:Name="ToneBox" Height="32" Margin="0,4,0,0">
                            <ComboBoxItem Content="warm" />
                            <ComboBoxItem Content="neutral" />
                            <ComboBoxItem Content="brief" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="ProfilesPage" Visibility="Collapsed">
                        <TextBlock Text="Profiles" FontSize="15" FontWeight="SemiBold" Foreground="#1C1B18" />
                        <TextBlock Text="Choose the shell HOPA uses." FontSize="11" Foreground="#9A9488"
                                   Margin="0,4,0,12" />
                        <ListBox x:Name="ProfileList" Height="220" />
                        <TextBlock x:Name="ProfileStatus" FontSize="10" Foreground="#6B665C"
                                   Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="ActPage" Visibility="Collapsed">
                        <TextBlock Text="Act" FontSize="15" FontWeight="SemiBold" Foreground="#1C1B18" />
                        <TextBlock Text="Where the next task runs." FontSize="11" Foreground="#9A9488"
                                   Margin="0,4,0,12" />
                        <RadioButton x:Name="PcTargetRadio" GroupName="Target" Content="This PC"
                                     Foreground="#1C1B18" Margin="0,0,0,6"
                                     Checked="Target_Changed" />
                        <TextBlock Text="UI Automation on this desktop; the PC is the acting device."
                                   FontSize="10" Foreground="#9A9488" Margin="22,0,0,14"
                                   TextWrapping="Wrap" />
                        <RadioButton x:Name="PhoneTargetRadio" GroupName="Target" Content="The phone"
                                     Foreground="#1C1B18" Margin="0,0,0,6"
                                     Checked="Target_Changed" />
                        <TextBlock Text="Hand the task to the phone over the gateway. The phone owns the run; the PC does not mirror its screen."
                                   FontSize="10" Foreground="#9A9488" Margin="22,0,0,14"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ActStatus" FontSize="10" Foreground="#6B665C" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="RunPage" Visibility="Collapsed">
                        <TextBlock Text="Run" FontSize="15" FontWeight="SemiBold" Foreground="#1C1B18" />
                        <TextBlock Text="How a turn is allowed to work." FontSize="11" Foreground="#9A9488"
                                   Margin="0,4,0,12" />
                        <TextBlock Text="Step source" FontSize="11.5" Foreground="#6B665C" />
                        <ComboBox x:Name="StepSourceBox" Height="32" Margin="0,4,0,4">
                            <ComboBoxItem Content="auto" />
                            <ComboBoxItem Content="model" />
                        </ComboBox>
                        <TextBlock Text="Auto uses a saved recipe or an instant command before the model. Model skips both. Windows has no graph/anchor catalogue."
                                   FontSize="10" Foreground="#9A9488" TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <CheckBox x:Name="ReplayBox" Content="Try a saved recipe before the model"
                                  Foreground="#1C1B18" Margin="0,0,0,6" />
                        <TextBlock Text="A recipe replays the steps that worked last time; a missing anchor falls back to the model."
                                   FontSize="10" Foreground="#9A9488" Margin="22,0,0,14"
                                   TextWrapping="Wrap" />
                        <CheckBox x:Name="PlanFirstBox" Content="Ask for a plan before acting"
                                  Foreground="#1C1B18" Margin="0,0,0,6" />
                        <TextBlock Text="The first reply is a numbered plan; nothing runs until you approve it."
                                   FontSize="10" Foreground="#9A9488" Margin="22,0,0,14"
                                   TextWrapping="Wrap" />
                        <CheckBox x:Name="InstantCommandsBox" Content="Run recognized commands without the model"
                                  Foreground="#1C1B18" Margin="0,0,0,6" />
                        <TextBlock Text="Open/back/home/scroll goals are deterministic; anything else goes to the model."
                                   FontSize="10" Foreground="#9A9488" Margin="22,0,0,14"
                                   TextWrapping="Wrap" />
                        <CheckBox x:Name="VisionBox" Content="Attach a screenshot to each model call"
                                  Foreground="#1C1B18" Margin="0,0,0,6" />
                        <TextBlock Text="Only useful when the selected model accepts images; the frame leaves this PC."
                                   FontSize="10" Foreground="#9A9488" Margin="22,0,0,14"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="MemoryPage" Visibility="Collapsed">
                        <TextBlock Text="Memory" FontSize="15" FontWeight="SemiBold" Foreground="#1C1B18" />
                        <TextBlock Text="Facts HOPA keeps and sends with each turn."
                                   FontSize="11" Foreground="#9A9488" Margin="0,4,0,12" />
                        <ListBox x:Name="MemoryList" Height="240" />
                        <TextBox x:Name="MemoryTextBox" Height="32" Margin="0,10,0,0"
                                 ToolTip="A fact to remember" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="MemoryAddButton" Content="Remember" Width="110" Height="32"
                                    Click="MemoryAdd_Click" />
                            <Button x:Name="MemoryDeleteButton" Content="Forget selected" Width="130" Height="32"
                                    Margin="8,0,0,0" Click="MemoryDelete_Click" />
                        </StackPanel>
                        <TextBlock x:Name="MemoryStatus" FontSize="10" Foreground="#6B665C"
                                   Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="SkillsPage" Visibility="Collapsed">
                        <TextBlock Text="Skills" FontSize="15" FontWeight="SemiBold" Foreground="#1C1B18" />
                        <TextBlock Text="Triggers the user taught HOPA." FontSize="11" Foreground="#9A9488"
                                   Margin="0,4,0,12" />
                        <ListBox x:Name="SkillList" Height="220" />
                        <TextBox x:Name="SkillTriggerBox" Height="32" Margin="0,10,0,0"
                                 ToolTip="Trigger phrase" />
                        <TextBox x:Name="SkillActionBox" Height="32" Margin="0,8,0,0"
                                 ToolTip="Action to run" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="SkillAddButton" Content="Teach" Width="110" Height="32"
                                    Click="SkillAdd_Click" />
                            <Button x:Name="SkillDeleteButton" Content="Forget selected" Width="130" Height="32"
                                    Margin="8,0,0,0" Click="SkillDelete_Click" />
                        </StackPanel>
                        <TextBlock x:Name="SkillStatus" FontSize="10" Foreground="#6B665C"
                                   Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="UsagePage" Visibility="Collapsed">
                        <TextBlock Text="Usage" FontSize="15" FontWeight="SemiBold" Foreground="#1C1B18" />
                        <TextBlock Text="Counters from the Windows record chain." FontSize="11"
                                   Foreground="#9A9488" Margin="0,4,0,12" />
                        <TextBlock x:Name="UsageTotal" FontSize="12" Foreground="#1C1B18" />
                        <TextBlock x:Name="UsageExecuted" FontSize="12" Foreground="#1C1B18" Margin="0,4,0,0" />
                        <TextBlock x:Name="UsageFailed" FontSize="12" Foreground="#1C1B18" Margin="0,4,0,0" />
                        <TextBlock x:Name="UsagePayments" FontSize="12" Foreground="#1C1B18" Margin="0,4,0,0" />
                        <TextBlock x:Name="UsageWeek" FontSize="12" Foreground="#1C1B18" Margin="0,4,0,0" />
                        <TextBlock Text="Top actions" FontSize="11" Foreground="#6B665C" Margin="0,14,0,4" />
                        <TextBlock x:Name="UsageTop" FontSize="11" Foreground="#1C1B18" TextWrapping="Wrap" />
                        <TextBlock x:Name="UsageStatus" FontSize="10" Foreground="#6B665C" Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="CapabilitiesPage" Visibility="Collapsed">
                        <TextBlock Text="Capabilities" FontSize="15" FontWeight="SemiBold" Foreground="#1C1B18" />
                        <TextBlock Text="What this PC can actually do right now." FontSize="11"
                                   Foreground="#9A9488" Margin="0,4,0,12" />
                        <TextBlock x:Name="CapabilityText" FontSize="12" Foreground="#1C1B18"
                                   TextWrapping="Wrap" LineHeight="22" />
                        <TextBlock x:Name="CapabilityStatus" FontSize="10" Foreground="#6B665C" Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="HowActsPage" Visibility="Collapsed">
                        <TextBlock Text="How HOPA acts" FontSize="15" FontWeight="SemiBold" Foreground="#1C1B18" />
                        <TextBlock Text="The same gate and the same tiers on the PC." FontSize="11"
                                   Foreground="#9A9488" Margin="0,4,0,12" />
                        <TextBlock FontSize="12" Foreground="#1C1B18" TextWrapping="Wrap" LineHeight="22"
                                   Text="Each action is classified first. HOPA then picks the cheapest tier that can do the job:&#10;&#10;1. API — a typed function or a known system call.&#10;2. Intent — a Windows URI or shell activation, before any click.&#10;3. UI Automation — the control's own pattern; a real click only when the pattern is absent.&#10;4. Input — the mouse or keyboard, used last.&#10;&#10;Every step records the tier it used. A payment or destructive action always asks first; a missing, late or malformed answer denies and executes nothing. The record chain names the tier, the verification and the device that approved." />
                        <TextBlock Text="Profiles: Everyday and Power keep the run rail; Easy, Kid and Social hide it."
                                   FontSize="11" Foreground="#6B665C" Margin="0,14,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="RecipesPage" Visibility="Collapsed">
                        <TextBlock Text="Recipes" FontSize="15" FontWeight="SemiBold" Foreground="#1C1B18" />
                        <TextBlock Text="Goals HOPA can replay without the model."
                                   FontSize="11" Foreground="#9A9488" Margin="0,4,0,12" />
                        <ListBox x:Name="RecipeList" Height="260" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="RecipeDeleteButton" Content="Delete selected" Width="130" Height="32"
                                    Click="RecipeDelete_Click" />
                            <Button x:Name="RecipeClearButton" Content="Clear all" Width="100" Height="32"
                                    Margin="8,0,0,0" Click="RecipeClear_Click" />
                        </StackPanel>
                        <TextBlock x:Name="RecipeStatus" FontSize="10" Foreground="#6B665C" Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="HistoryPage" Visibility="Collapsed">
                        <TextBlock Text="History" FontSize="15" FontWeight="SemiBold" Foreground="#1C1B18" />
                        <TextBlock Text="Finished turns on this PC." FontSize="11" Foreground="#9A9488"
                                   Margin="0,4,0,12" />
                        <ListBox x:Name="HistoryList" Height="320" />
                        <Button x:Name="HistoryRefreshButton" Content="Refresh" Width="100" Height="32"
                                HorizontalAlignment="Left" Margin="0,8,0,0" Click="HistoryRefresh_Click" />
                        <TextBlock x:Name="HistoryStatus" FontSize="10" Foreground="#6B665C" Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="PrivacyPage" Visibility="Collapsed">
                        <TextBlock Text="Privacy" FontSize="15" FontWeight="SemiBold" Foreground="#1C1B18" />
                        <TextBlock Text="What left this PC: finished turns and the actions they sent."
                                   FontSize="11" Foreground="#9A9488" Margin="0,4,0,12" TextWrapping="Wrap" />
                        <ListBox x:Name="PrivacyList" Height="320" />
                        <Button x:Name="PrivacyRefreshButton" Content="Refresh" Width="100" Height="32"
                                HorizontalAlignment="Left" Margin="0,8,0,0" Click="PrivacyRefresh_Click" />
                        <TextBlock x:Name="PrivacyStatus" FontSize="10" Foreground="#6B665C" Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="NotificationsPage" Visibility="Collapsed">
                        <TextBlock Text="Notifications" FontSize="15" FontWeight="SemiBold" Foreground="#1C1B18" />
                        <TextBlock Text="Recent Windows toasts. The PC owns this surface."
                                   FontSize="11" Foreground="#9A9488" Margin="0,4,0,12" />
                        <ListBox x:Name="NotificationList" Height="300" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="NotificationClearButton" Content="Clear" Width="100" Height="32"
                                    Click="NotificationClear_Click" />
                            <Button x:Name="NotificationRefreshButton" Content="Refresh" Width="100" Height="32"
                                    Margin="8,0,0,0" Click="NotificationRefresh_Click" />
                        </StackPanel>
                        <TextBlock x:Name="NotificationStatus" FontSize="10" Foreground="#6B665C" Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="LaunchpadPage" Visibility="Collapsed">
                        <TextBlock Text="Launchpad" FontSize="15" FontWeight="SemiBold" Foreground="#1C1B18" />
                        <TextBlock Text="Apps the Start menu offers." FontSize="11" Foreground="#9A9488"
                                   Margin="0,4,0,12" />
                        <ListBox x:Name="LaunchpadList" Height="300" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="LaunchpadLaunchButton" Content="Launch" Width="100" Height="32"
                                    Click="LaunchpadLaunch_Click" />
                            <Button x:Name="LaunchpadStopButton" Content="Stop" Width="100" Height="32"
                                    Margin="8,0,0,0" Click="LaunchpadStop_Click" />
                            <Button x:Name="LaunchpadRefreshButton" Content="Refresh" Width="100" Height="32"
                                    Margin="8,0,0,0" Click="LaunchpadRefresh_Click" />
                        </StackPanel>
                        <TextBlock x:Name="LaunchpadStatus" FontSize="10" Foreground="#6B665C" Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="BrowserPage" Visibility="Collapsed">
                        <TextBlock Text="Browser" FontSize="15" FontWeight="SemiBold" Foreground="#1C1B18" />
                        <TextBlock Text="A WebView2 surface on this PC; link-out remains the fallback."
                                   FontSize="11" Foreground="#9A9488" Margin="0,4,0,12"
                                   TextWrapping="Wrap" />
                        <TextBox x:Name="BrowserUrlBox" Height="32" Margin="0,0,0,8"
                                 ToolTip="A URL to open" />
                        <Button x:Name="BrowserOpenButton" Content="Open browser" Width="130" Height="32"
                                HorizontalAlignment="Left" Click="BrowserOpen_Click" />
                        <TextBlock x:Name="BrowserStatus" FontSize="10" Foreground="#6B665C" Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="SelfCheckPage" Visibility="Collapsed">
                        <TextBlock Text="Self check" FontSize="15" FontWeight="SemiBold" Foreground="#1C1B18" />
                        <TextBlock Text="Sidecar, device, bridge and credentials, checked live."
                                   FontSize="11" Foreground="#9A9488" Margin="0,4,0,12" />
                        <Button x:Name="SelfCheckButton" Content="Run checks" Width="110" Height="32"
                                HorizontalAlignment="Left" Click="SelfCheck_Click" />
                        <TextBlock x:Name="SelfCheckText" FontSize="11" Foreground="#1C1B18"
                                   TextWrapping="Wrap" LineHeight="20" Margin="0,12,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                        <TextBlock Text="About" FontSize="15" FontWeight="SemiBold" Foreground="#1C1B18" />
                        <TextBlock x:Name="AboutText" FontSize="12" Foreground="#1C1B18"
                                   TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="22,16,22,18">
            <Button x:Name="CancelButton" Content="Cancel" Width="96" Height="34"
                    Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="SaveButton" Content="Save" Width="96" Height="34"
                    Background="#0A59F7" Foreground="#FFFFFF" BorderThickness="0"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
