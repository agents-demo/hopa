<Window x:Class="Hopa.Windows.Ui.Dialogs.TakeoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Take over"
        Icon="pack://application:,,,/Hopa.Windows;component/Assets/hopa.ico"
        Height="260" Width="480"
        Background="#F7F4EE"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F7F4EE" Margin="-22,-22,-22,0" Padding="22,14"
                MouseLeftButtonDown="Header_Drag">
            <Grid>
                <TextBlock Text="Take over" FontSize="15" FontWeight="SemiBold" Foreground="#1C1B18" />
                <Button Content="&#x2715;" HorizontalAlignment="Right" Width="30" Height="28"
                        Background="Transparent" BorderThickness="0" Foreground="#6B665C"
                        Click="Cancel_Click" AutomationProperties.Name="Cancel takeover" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Text="The turn is paused. Finish the step by hand, then resume so HOPA can re-read the screen and continue. Cancel leaves the turn stopped."
                   FontSize="12" Foreground="#1C1B18" TextWrapping="Wrap" Margin="0,16,0,0" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel turn" Width="110" Height="34" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Resume" Width="100" Height="34" Background="#0A59F7"
                    Foreground="#FFFFFF" BorderThickness="0" Click="Resume_Click" />
        </StackPanel>
    </Grid>
</Window>
