<Window x:Class="Hopa.Windows.Ui.Dialogs.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="HOPA Browser"
        Icon="pack://application:,,,/Hopa.Windows;component/Assets/hopa.ico"
        Height="720" Width="1040"
        Background="#F7F4EE"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F7F4EE" BorderBrush="#E9E4DA" BorderThickness="0,0,0,1"
                Padding="12,10" MouseLeftButtonDown="Header_Drag">
            <Grid>
                <TextBlock Text="HOPA Browser" FontSize="13" FontWeight="SemiBold" Foreground="#1C1B18"
                           VerticalAlignment="Center" Margin="4,0,0,0" />
                <Button Content="&#x2715;" HorizontalAlignment="Right" Width="30" Height="28"
                        Background="Transparent" BorderThickness="0" Foreground="#6B665C"
                        Click="Close_Click" AutomationProperties.Name="Close browser" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12,10,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="&#x2190;" Width="32" Height="30" Click="Back_Click" ToolTip="Back" />
            <Button Grid.Column="1" Content="&#x2192;" Width="32" Height="30" Margin="4,0,0,0"
                    Click="Forward_Click" ToolTip="Forward" />
            <Button Grid.Column="2" Content="&#x21BB;" Width="32" Height="30" Margin="4,0,0,0"
                    Click="Reload_Click" ToolTip="Reload" />
            <TextBox x:Name="AddressBox" Grid.Column="3" Height="30" Margin="8,0,0,0"
                     KeyDown="Address_KeyDown" />
            <Button Grid.Column="4" Content="Go" Width="52" Height="30" Margin="8,0,0,0"
                    Click="Go_Click" />
        </Grid>

        <wv2:WebView2 x:Name="Web" Grid.Row="2" Margin="12,0" />

        <TextBlock x:Name="StatusText" Grid.Row="3" FontSize="10" Foreground="#6B665C"
                   Margin="12,8,12,12" TextWrapping="Wrap" />
    </Grid>
</Window>
