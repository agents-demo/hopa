<Window x:Class="Hopa.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Hopa.Windows.Controls"
        Title="HOPA"
        Icon="Assets/hopa.ico"
        Height="760" Width="1140"
        Background="#F7F4EE"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowDrop="True"
        Drop="Window_Drop"
        KeyboardNavigation.TabNavigation="Cycle"
        KeyboardNavigation.ControlTabNavigation="Cycle"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- W6: the Harmony laptop conversation. A user turn is a blue bubble;
             an answer is mark + text, no bubble. -->

        <DataTemplate x:Key="MessageTemplate">
            <Grid Margin="0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:HopaMark x:Name="Mark" Width="22" Height="22" IsStatic="True"
                                   Margin="0,1,12,0" VerticalAlignment="Top" Visibility="Collapsed" />
                <Border x:Name="Bubble" Grid.Column="1" Background="{Binding Fill}"
                        CornerRadius="14" Padding="14,10" MaxWidth="620"
                        HorizontalAlignment="{Binding Align}">
                    <StackPanel>
                        <TextBlock Text="{Binding Text}" Foreground="{Binding Ink}" FontSize="13.5"
                                   LineHeight="21" TextWrapping="Wrap" />
                        <TextBlock x:Name="Meta" Text="HOPA on this laptop" FontSize="9.5"
                                   Foreground="#9A9488" Margin="0,6,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="False">
                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Bubble" Property="Background" Value="Transparent" />
                    <Setter TargetName="Bubble" Property="Padding" Value="0" />
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Left" />
                    <Setter TargetName="Bubble" Property="MaxWidth" Value="760" />
                    <Setter TargetName="Meta" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ConversationTemplate">
            <Grid Height="30" Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{Binding TitleInk}" />
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel x:Name="RowMeta" Orientation="Horizontal">
                        <TextBlock Text="{Binding PinLabel}" FontSize="9" FontWeight="SemiBold"
                                   Foreground="#E8703A" Margin="6,0,0,0" />
                        <TextBlock Text="{Binding UpdatedLabel}" FontSize="9.5" Foreground="#9A9488"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="More" Text="\u22EF" FontSize="13" Foreground="#9A9488"
                               HorizontalAlignment="Right" Cursor="Hand" Visibility="Collapsed"
                               MouseLeftButtonUp="More_Click" Margin="6,0,0,0" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                             Value="True">
                    <Setter TargetName="More" Property="Visibility" Value="Visible" />
                    <Setter TargetName="RowMeta" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: 212, surface_alt, the Harmony geometry. -->
        <Border Background="#F3EFE7">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,14,12,8">
                    <Button Content="+ New chat" Height="30" HorizontalContentAlignment="Left"
                            Padding="10,0" Background="Transparent" BorderThickness="0"
                            Foreground="#6B665C" FontSize="12.5" Click="NewChat_Click"
                            AutomationProperties.Name="New chat" />
                    <Grid Margin="0,6,0,0">
                        <TextBox x:Name="SearchBox" Height="34" VerticalContentAlignment="Center"
                                 Padding="8,0,52,0" FontSize="12" BorderThickness="1"
                                 BorderBrush="#E9E4DA" Background="#F1ECE3"
                                 AutomationProperties.Name="Search conversations"
                                 TextChanged="SearchBox_TextChanged" />
                        <TextBlock x:Name="SearchPlaceholder" Text="Search" IsHitTestVisible="False"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontSize="12" Foreground="#9A9488" />
                        <TextBlock Text="Ctrl K" IsHitTestVisible="False" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Margin="0,0,9,0" FontSize="9.5"
                                   Foreground="#9A9488" Opacity="0.45" />
                    </Grid>
                    <CheckBox x:Name="ShowArchivedBox" Content="Show archived" Margin="2,8,0,0"
                              FontSize="9.5" Foreground="#6B665C" Click="ShowArchived_Click"
                              AutomationProperties.Name="Show archived conversations" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="#E9E4DA" BorderThickness="0,1,0,0"
                        Padding="12,10">
                    <StackPanel>
                        <Button x:Name="SettingsButton" Content="Settings" Height="28"
                                HorizontalContentAlignment="Left" Padding="8,0" Background="Transparent"
                                BorderThickness="0" Foreground="#6B665C" FontSize="12"
                                Click="Settings_Click" AutomationProperties.Name="Settings" />
                        <TextBlock x:Name="NoBridgeHint" Text="No bridge · Set up" FontSize="11"
                                   Foreground="#B26A00" Margin="8,4,0,0" Visibility="Collapsed"
                                   MouseLeftButtonUp="NoBridge_Click" />
                    </StackPanel>
                </Border>

                <ListBox x:Name="ConversationList" BorderThickness="0" Background="Transparent"
                         ItemTemplate="{StaticResource ConversationTemplate}" Margin="12,0,12,8"
                         SelectionChanged="ConversationList_SelectionChanged"
                         AutomationProperties.Name="Conversations">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="9" FontWeight="Bold"
                                               Foreground="#9A9488" Margin="4,8,0,2" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Pin / Unpin" Click="Pin_Click" />
                            <MenuItem Header="Archive / Unarchive" Click="Archive_Click" />
                            <MenuItem Header="Rename" Click="Rename_Click" />
                            <MenuItem Header="Export..." Click="Export_Click" />
                            <MenuItem Header="Delete" Click="Delete_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="#E9E4DA" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: 56, 22 gutter, mark 26, title 15, quiet actions. -->
            <Border Grid.Row="0" Background="#F7F4EE" BorderBrush="#E9E4DA" BorderThickness="0,0,0,1">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:HopaMark Width="26" Height="26" IsStatic="True"
                                       Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="New chat" FontSize="15"
                                   FontWeight="Medium" Foreground="#1C1B18"
                                   AutomationProperties.Name="Conversation title" />
                        <TextBlock x:Name="SubtitleText" Text="Running on this laptop"
                                   FontSize="10" Foreground="#9A9488" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Grid.Column="2" Text="" VerticalAlignment="Center"
                               Margin="16,0" FontSize="10" Foreground="#9A9488"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed" />

                    <StackPanel x:Name="WindowButtons" Grid.Column="6" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="MinimizeButton" Content="&#x2013;" Width="30" Height="28"
                                Background="Transparent" BorderThickness="0" Foreground="#6B665C"
                                Click="Minimize_Click" AutomationProperties.Name="Minimize" />
                        <Button x:Name="MaximizeButton" Content="&#x25A1;" Width="30" Height="28"
                                Background="Transparent" BorderThickness="0" Foreground="#6B665C"
                                Click="Maximize_Click" AutomationProperties.Name="Maximize" />
                        <Button x:Name="CloseButton" Content="&#x2715;" Width="30" Height="28"
                                Background="Transparent" BorderThickness="0" Foreground="#6B665C"
                                Click="Close_Click" AutomationProperties.Name="Close" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Conversation: 22 gutter, like the Harmony list. -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Hidden"
                              Padding="22,0,22,10">
                    <ItemsControl x:Name="MessagesList" ItemTemplate="{StaticResource MessageTemplate}" />
                </ScrollViewer>
                <StackPanel x:Name="AnswerActions" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Orientation="Horizontal" Margin="0,0,4,4" Visibility="Collapsed">
                    <Button x:Name="CopyButton" Content="Copy" Height="24" Padding="8,0"
                            Background="Transparent" BorderThickness="0" Foreground="#9A9488"
                            FontSize="9.5" IsEnabled="False" Click="Copy_Click"
                            AutomationProperties.Name="Copy the last answer" />
                    <Button x:Name="SpeakButton" Content="Speak" Height="24" Padding="8,0"
                            Background="Transparent" BorderThickness="0" Foreground="#9A9488"
                            FontSize="9.5" IsEnabled="False" Click="Speak_Click"
                            AutomationProperties.Name="Read the last answer aloud" />
                    <Button x:Name="DetailsButton" Content="Run" Height="24" Padding="8,0"
                            Background="Transparent" BorderThickness="0" Foreground="#9A9488"
                            FontSize="9.5" IsEnabled="False" Click="Details_Click"
                            AutomationProperties.Name="Run details" />
                </StackPanel>
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <controls:HopaMark Width="108" Height="108" />
                    <TextBlock Text="HOPA" FontSize="27" FontWeight="SemiBold" Foreground="#1C1B18"
                               HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock Text="Your assistant. Ask for anything."
                               FontSize="15" Foreground="#6B665C" HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                    <TextBlock Text="Payments always ask first."
                               FontSize="12.5" Foreground="#9A9488" HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ErrorText" Grid.Row="2" Text="" Margin="22,0,22,4" FontSize="10.5"
                       Foreground="#C0392B" TextWrapping="Wrap" Visibility="Collapsed" />
            <Border x:Name="PendingAttachmentBar" Grid.Row="3" Margin="22,8,22,0"
                    Background="#F1ECE3" CornerRadius="9" Padding="10,8" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PendingAttachmentName" FontSize="11.5"
                                   Foreground="#1C1B18" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PendingAttachmentDetail" FontSize="9.5" Foreground="#9A9488" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Remove" Height="24" Padding="8,0"
                            Background="Transparent" BorderThickness="0" Foreground="#6B665C"
                            FontSize="9.5" Click="RemoveAttachment_Click"
                            AutomationProperties.Name="Remove attachment" />
                </Grid>
            </Border>

            <!-- Composer: a 24-radius pill with one 44 circle at the end. -->
            <Grid Grid.Row="4" Margin="22,8,22,18">
                <Border Background="#FFFFFF" CornerRadius="24" BorderBrush="#E9E4DA"
                        BorderThickness="1" Padding="20,3,8,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="Composer" BorderThickness="0" Background="Transparent"
                                     FontSize="13.5" TextWrapping="Wrap" MinHeight="38" MaxHeight="132"
                                     VerticalContentAlignment="Center" KeyDown="Composer_KeyDown"
                                     TextChanged="Composer_TextChanged"
                                     VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Message" />
                            <TextBlock x:Name="ComposerPlaceholder" Text="Ask HOPA…" IsHitTestVisible="False"
                                       VerticalAlignment="Center" FontSize="13.5" Foreground="#9A9488" />
                        </Grid>
                        <TextBlock x:Name="TargetChip" Grid.Column="0" Text="Laptop" FontSize="10"
                                   Foreground="#9A9488" Background="#F1ECE3" Padding="8,5" Margin="0,0,10,0"
                                   VerticalAlignment="Center" Cursor="Hand" Visibility="Collapsed"
                                   MouseLeftButtonUp="TargetChip_Click" />
                        <Button x:Name="MicButton" Grid.Column="2" Content="&#xE720;"
                                Width="44" Height="44" Margin="0,0,6,0" Background="#F1ECE3"
                                BorderThickness="0" Foreground="#6B665C" FontSize="14"
                                FontFamily="Segoe MDL2 Assets"
                                Click="Mic_Click" AutomationProperties.Name="Dictate a message" />
                        <Button x:Name="SendButton" Grid.Column="3" Content="&#x2191;"
                                Width="44" Height="44" Background="#0A59F7" Foreground="#FFFFFF"
                                BorderThickness="0" FontSize="18" Click="Send_Click"
                                AutomationProperties.Name="Send message" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Right rail: the run behind the answer, 258 like the Harmony shell. -->
        <Border Grid.Column="3" Width="258" Background="Transparent" Padding="10,68,10,12">
            <Border Background="#FFFFFF" CornerRadius="14" BorderBrush="#E9E4DA" BorderThickness="1"
                    Padding="14,12,14,10">
                <DockPanel>
                    <TextBlock x:Name="RailTitle" DockPanel.Dock="Top" Text="THIS ANSWER" FontSize="9"
                               FontWeight="Bold" Foreground="#9A9488" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse x:Name="RailDot" Width="7" Height="7" Fill="#9A9488"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="RailStatus" Text="Nothing ran yet" FontSize="15"
                                   FontWeight="Medium" Foreground="#1C1B18" Margin="7,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="RailFacts" DockPanel.Dock="Top" Text="" FontSize="10.5"
                               Foreground="#9A9488" Margin="0,3,0,0" />
                    <TextBlock x:Name="RailEarlier" DockPanel.Dock="Top" Text="" FontSize="10"
                               Foreground="#9A9488" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="RailMeasured" DockPanel.Dock="Top" Text="" FontSize="10"
                               Foreground="#9A9488" Margin="0,6,0,0" Visibility="Collapsed" />
                    <Border DockPanel.Dock="Bottom" BorderBrush="#E9E4DA" BorderThickness="0,1,0,0"
                            Padding="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RailBridgeDot" Width="6" Height="6" Fill="#B26A00"
                                     VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBlock x:Name="RailBridge" Text="No bridge · this conversation only"
                                       FontSize="10" Foreground="#9A9488" Margin="6,0,0,0"
                                       TextWrapping="Wrap" Width="196" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="0,8,0,0">
                        <ItemsControl x:Name="RailSteps">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="18" Height="18" CornerRadius="9"
                                                Background="{Binding Dot}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Number}" FontSize="9.5"
                                                       Foreground="#FFFFFF" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Verb}" FontSize="11.5"
                                                       Foreground="#1C1B18" />
                                            <TextBlock Text="{Binding Detail}" FontSize="10"
                                                       Foreground="#9A9488" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</Window>
