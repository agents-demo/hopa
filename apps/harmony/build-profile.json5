{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "compileSdkVersion": "6.1.1(24)",
        "compatibleSdkVersion": "6.1.1(24)",
        "targetSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        { "name": "default", "applyToProducts": ["default"] }
      ]
    },
    { "name": "core", "srcPath": "./core" },
    { "name": "capability_web", "srcPath": "./capabilities/web" },
        { "name": "capability_llm", "srcPath": "./capabilities/llm" },
    { "name": "capability_sandbox", "srcPath": "./capabilities/sandbox" },
    { "name": "capability_a11y", "srcPath": "./capabilities/a11y" },
    { "name": "capability_system", "srcPath": "./capabilities/system" }
  ]
}
