{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agents-demo/hopa/schemas/run-record.schema.json",
  "title": "RunRecord",
  "description": "One append-only, hash-chained step record.",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "step",
    "traceId",
    "action",
    "classification",
    "approved",
    "observationHash",
    "verified",
    "executed",
    "prevHash",
    "hash"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "runId": { "type": "string", "minLength": 1 },
    "step": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "string" },
    "traceId": { "type": "string" },
    "action": { "$ref": "action.schema.json" },
    "classification": { "type": "string", "enum": ["read", "sensitive", "payment"] },
    "approved": { "type": ["boolean", "null"] },
    "observationHash": { "type": "string" },
    "beforeHash": { "type": "string" },
    "afterHash": { "type": "string" },
    "verified": { "type": "boolean" },
    "executed": { "type": "boolean" },
    "error": { "type": ["string", "null"] },
    "prevHash": { "type": "string" },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
