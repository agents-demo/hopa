{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agents-demo/hopa/schemas/observation.schema.json",
  "title": "Observation",
  "description": "One redacted, hashable view of a HarmonyOS screen.",
  "type": "object",
  "required": ["schemaVersion", "id", "timestamp", "screenSize", "tree", "hash"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "integer", "minimum": 0 },
    "displayId": { "type": "integer", "minimum": 0 },
    "windowId": { "type": "string" },
    "rotation": { "type": "integer", "enum": [0, 90, 180, 270] },
    "density": { "type": "number", "exclusiveMinimum": 0 },
    "screenSize": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "focus": { "type": "string" },
    "text": { "type": "string" },
    "tree": { "$ref": "#/$defs/node" },
    "screenshotRef": { "type": "string" },
    "app": { "type": "string" },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "truncated": { "type": "boolean" }
  },
  "additionalProperties": false,
  "$defs": {
    "bounds": {
      "type": ["array", "null"],
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "integer" }
    },
    "node": {
      "type": "object",
      "required": ["ref", "type", "children"],
      "properties": {
        "ref": { "type": "string" },
        "type": { "type": "string" },
        "text": { "type": "string" },
        "description": { "type": "string" },
        "id": { "type": "string" },
        "bounds": { "$ref": "#/$defs/bounds" },
        "clickable": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "checked": { "type": "boolean" },
        "scrollable": { "type": "boolean" },
        "visible": { "type": "boolean" },
        "focused": { "type": "boolean" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "additionalProperties": false
    }
  }
}
